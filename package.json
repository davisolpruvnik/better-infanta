{
  "name": "betterlocalgov",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
      "dev": "vite",
      "build": "pnpm convert-yaml && tsc && vite build",
      "lint": "eslint .",
      "lint:fix": "eslint . --fix",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "preview": "pnpm build && wrangler dev",
      "convert-yaml": "node scripts/yaml-to-json.js",
      "dev:yaml": "pnpm convert-yaml && pnpm dev",
      "setup": "node scripts/setup-starter-kit.js",
      "deploy": "pnpm build && wrangler deploy"
    },
  "pnpm": {
      "onlyBuiltDependencies": [
        "cloudflared",
        "esbuild",
        "workerd"
      ]
    },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@bettergov/kapwa": "^1.2.4",
    "@fontsource-variable/google-sans-flex": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify/react": "^6.0.2",
    "@meteocons/svg-static": "^0.1.0",
    "@tailwindcss/typography": "^0.5.18",
    "@types/js-yaml": "^4.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hyparquet": "^1.29.1",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "js-yaml": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "maplibre-gl": "^6.13.0",
    "motion": "^13.1.0",
    "nuqs": "^2.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^15.7.3",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.2",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "lint-staged": "^16.1.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.6",
    "vite-bundle-visualizer": "^1.2.1",
    "wrangler": "^4.119.0"
  }
}
